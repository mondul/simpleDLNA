<Project>

  <!--
    Shared settings for every project in the repository.
    Replaces the per-project boilerplate of the old non-SDK csproj files and
    the linked GlobalAssemblyInfo.cs.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- The old projects were built against a wildcard AssemblyVersion, which
         deterministic builds reject. Versions are now pinned explicitly. -->
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- Assembly identity, formerly GlobalAssemblyInfo.cs -->
  <PropertyGroup>
    <Company>Nils Maier</Company>
    <Product>SimpleDLNA</Product>
    <Copyright>Copyright © 2012-2016 Nils Maier</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
    <!-- The single source of version truth. AssemblyVersion, FileVersion and
         InformationalVersion are all derived from it by the SDK, so the release
         workflow only has to override this one property
         (-p:VersionPrefix=x.y.z). -->
    <VersionPrefix>2.0.0</VersionPrefix>
    <!-- Keep InformationalVersion free of the trailing +<commit sha> the SDK
         would otherwise append; it is surfaced to clients via
         ProductInformation.ProductVersion. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- Strong naming, against the single key at the repository root -->
  <PropertyGroup>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)sdlna.key.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <!-- Everything below applies to the shipped assemblies, not the tests. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'tests'">
    <!-- Attributes the SDK cannot express as properties. The test assembly is
         not a public API, so it is not declared CLS-compliant (xUnit's
         InlineData would otherwise raise CS3016 on every use). -->
    <Compile Include="$(MSBuildThisFileDirectory)AssemblyAttributes.cs" Link="Properties/AssemblyAttributes.cs" />

    <!-- Lets the test project reach internal types. The key is the public half
         of sdlna.key.snk, which signs the tests too. -->
    <InternalsVisibleTo Include="SimpleDlna.Tests" Key="" />
  </ItemGroup>

</Project>
